{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "InstanceName": "AabuReports:",
    "AbsoluteExpiration": 60,
    "SlidingExpiration": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4000" ]
  },
  "JWT": {
    "RefreshTokenLifeTimeInSeconds": 604800,
    "AccessTokenLifeTimeInSeconds": 86400,
    "Issuer": "temp",
    "Audience": "temp "
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
